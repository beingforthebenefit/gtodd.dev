---
// Not a real page: the build screenshots it at 1200×630 into /og/card.png,
// the preview image for links shared on LinkedIn, Slack and the like.
import Base from '../layouts/Base.astro';
import { basics } from '../data/resume';
import { personSchema } from '../lib/schema';
---

<Base title="gtodd.dev card" description="Social preview card." schema={{ '@context': 'https://schema.org', ...personSchema() }} noindex>
  <div class="card" data-hero>
    <canvas aria-hidden="true"></canvas>
    <div class="card__text">
      <h1>{basics.name}</h1>
      <p class="math"><strong>Definition.</strong> <em>A software engineer is someone who explains things to computers, and then to whoever maintains the code next.</em></p>
      <p class="card__url">gtodd.dev</p>
    </div>
  </div>
</Base>

<script>
  import { mountSlopeField } from '../scripts/slope-field';

  const host = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = host?.querySelector('canvas');
  if (host && canvas) mountSlopeField(canvas, host);
</script>

<style>
  .card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .card__text {
    position: relative;
    padding: 96px 80px;
    width: 640px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  h1 {
    font-size: 96px;
    line-height: 0.9;
    font-weight: 750;
    letter-spacing: -0.045em;
  }

  .math {
    font-size: 28px;
    line-height: 1.3;
  }

  .card__url {
    font-size: 22px;
    font-weight: 600;
    color: var(--accent);
  }
</style>
