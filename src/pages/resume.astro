---
// The résumé as a real web page. The same page, printed by a headless
// browser at build time, becomes /resume.pdf. One column, real text and
// standard headings, so applicant-tracking systems parse it cleanly.
import Base from '../layouts/Base.astro';
import { basics, work, education, awards, certifications, skills, paper, speech, formatRange } from '../data/resume';
import { resumeSchema } from '../lib/schema';

const [github, linkedin] = ['GitHub', 'LinkedIn'].map((n) => basics.profiles.find((p) => p.network === n)!);
const strip = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base
  title="Gerald Todd, résumé"
  description="Résumé of Gerald Todd, software engineer: AI systems, full-stack web development, and a background in university mathematics."
  schema={resumeSchema()}
>
  <main id="main" class="resume">
    <nav class="resume__tools" aria-label="Résumé">
      <a href="/">Back to gtodd.dev</a>
      <a class="button button--ink" href="/resume.pdf" download="Gerald-Todd-Resume.pdf">Download PDF</a>
    </nav>

    <header class="resume__header">
      <h1>{basics.name}</h1>
      <p class="resume__label">{basics.label}</p>
      <ul class="resume__contact">
        <li><a href={`mailto:${basics.email}`}>{basics.email}</a></li>
        <li>{basics.location.city}, {basics.location.region} (remote)</li>
        <li><a href={basics.url}>{strip(basics.url)}</a></li>
        <li><a href={linkedin.url}>{strip(linkedin.url)}</a></li>
        <li><a href={github.url}>{strip(github.url)}</a></li>
      </ul>
    </header>

    <section aria-labelledby="summary">
      <h2 id="summary">Summary</h2>
      <p>{basics.summary}</p>
    </section>

    <section aria-labelledby="experience">
      <h2 id="experience">Experience</h2>
      {
        work.map((job) => (
          <article class="job">
            <div class="job__line">
              <h3>{`${job.position}, ${job.organization}`}</h3>
              <span class="job__when">{formatRange(job.start, job.end)}</span>
            </div>
            <p class="job__where">{job.summary ? `${job.location}. ${job.summary}` : job.location}</p>
            <ul>
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section aria-labelledby="education">
      <h2 id="education">Education</h2>
      <ul class="plain">
        {
          education.map((d) => (
            <li>
              <div class="job__line">
                <span>
                  <strong>{`${d.studyType}, ${d.area}`}</strong>, {d.institution}
                </span>
                <span class="job__when">{d.end}</span>
              </div>
              {d.notes.length > 0 && <p class="muted">{d.notes.join(' ')}</p>}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="research">
      <h2 id="research">Research and speaking</h2>
      <ul>
        <li>
          <a href={`${basics.url}${paper.url}`}>{paper.title}</a> ({paper.year}). Master’s paper, advised by {paper.adviser}.
          Counts every symmetry of the Dowling geometry and finds its fixing number.
        </li>
        <li>
          “{paper.talkTitle},” {paper.venue}, {paper.venuePlace}, April 2016.
        </li>
        <li>
          <a href={speech.url}>Student reflection speech</a>, University of Montana mathematics graduation, May 2016.
        </li>
      </ul>
    </section>

    <section aria-labelledby="skills">
      <h2 id="skills">Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.name}</dt>
              <dd>{s.keywords.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="honors">
      <h2 id="honors">Honors and certifications</h2>
      <ul>
        {awards.map((a) => <li>{a.title}, {a.awarder}{a.date && `, ${a.date}`}</li>)}
        {certifications.map((c) => <li>{c}</li>)}
      </ul>
    </section>
  </main>
</Base>

<style>
  .resume {
    max-width: 820px;
    margin: 0 auto;
    padding: 32px var(--gutter) 80px;
    background: var(--paper);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
  }

  .resume__tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 40px;
  }

  .resume__tools a:not(.button) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  h1 {
    font-size: clamp(36px, 6vw, 44px);
    font-weight: 750;
    letter-spacing: -0.035em;
  }

  .resume__label {
    font-size: 18px;
    color: var(--ink-soft);
  }

  .resume__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14.5px;
  }

  section {
    margin-top: 28px;
  }

  h2 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding-bottom: 4px;
    margin-bottom: 12px;
    border-bottom: 1.5px solid var(--ink);
  }

  h3 {
    font-size: 16.5px;
    font-weight: 650;
  }

  .job + .job {
    margin-top: 16px;
  }

  .job__line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    flex-wrap: wrap;
  }

  .job__when {
    font-size: 14.5px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .job__where,
  .muted {
    font-size: 14.5px;
    color: var(--muted);
  }

  ul {
    margin: 6px 0 0;
    padding-left: 1.1em;
  }

  li + li {
    margin-top: 4px;
  }

  .plain {
    list-style: none;
    padding: 0;
  }

  .skills {
    margin: 0;
    display: grid;
    gap: 4px;
  }

  .skills div {
    display: grid;
    grid-template-columns: 9.5em 1fr;
    gap: 12px;
  }

  .skills dt {
    font-weight: 650;
  }

  .skills dd {
    margin: 0;
  }

  @media (max-width: 560px) {
    .skills div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @page {
    size: letter;
    margin: 0.55in 0.6in;
  }

  @media print {
    :global(body) {
      background: #fff;
      font-size: 10pt;
    }

    :global(.skip-link),
    .resume__tools {
      display: none;
    }

    .resume {
      max-width: none;
      padding: 0;
      background: #fff;
      font-size: 10pt;
      line-height: 1.38;
    }

    h1 {
      font-size: 24pt;
    }

    .resume__label {
      font-size: 11.5pt;
    }

    .resume__contact,
    .job__when,
    .job__where,
    .muted {
      font-size: 9.5pt;
    }

    section {
      margin-top: 14pt;
    }

    h2 {
      font-size: 10.5pt;
      margin-bottom: 6pt;
    }

    h3 {
      font-size: 10.5pt;
    }

    .job {
      break-inside: avoid;
    }

    .job + .job {
      margin-top: 9pt;
    }

    a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
