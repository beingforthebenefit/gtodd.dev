---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Facts from '../components/Facts.astro';
import Work from '../components/Work.astro';
import Projects from '../components/Projects.astro';
import Research from '../components/Research.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import { homeSchema } from '../lib/schema';
---

<Base
  title="Gerald Todd, software engineer"
  description="Software engineer building AI systems people can trust with high-stakes work. Former university math instructor with two master's degrees in mathematics. Remote, Pacific time."
  schema={homeSchema()}
>
  <Hero />
  <main id="main">
    <Facts />
    <Work />
    <Projects />
    <Research />
    <About />
  </main>
  <Footer />
</Base>
