---
import { Image } from 'astro:assets';
import portrait from '../assets/gerald.jpg';
import speechThumb from '../assets/speech.jpg';
import { speech, work, education } from '../data/resume';

const years = (start: string, end?: string) => {
  const a = start.slice(0, 4);
  if (!end) return `${a} to now`;
  const b = end.slice(0, 4);
  return a === b ? a : `${a}–${b.slice(2)}`;
};

const timelineNames: Record<string, string> = {
  AdaptiveStack: 'AdaptiveStack, VA contract',
  'iOSTheme.live': 'iOSTheme.live, founder',
  'University of Montana': 'University of Montana, instructor',
};

const timeline = [
  ...work.map((job) => ({
    name: timelineNames[job.organization] ?? job.organization,
    when: years(job.start, job.end),
  })),
  { name: `${education.at(-1)!.institution}, B.S.`, when: '2009–12' },
];
---

<section id="about" class="section about grid-12" aria-labelledby="about-title">
  <div class="about__text body-copy">
    <h2 id="about-title" class="section-title">About</h2>
    <p class="about__lead">
      I left high school at fifteen. At sixteen I signed up for a community college class called Linear Optimization,
      mostly to find out what it was.
    </p>
    <p>
      Turns out it was the next decade. That class led to Anchorage, as far from Bakersfield as my budget reached, and a
      math degree with the highest GPA across math and computer science. Then Missoula, and two master's degrees at once:
      one in combinatorics and optimization, one in analysis. I paid for all of it with work, grants, prizes and tuition
      waivers.
    </p>
    <p>
      Montana put me in front of about eighty students a semester, from college algebra to Calc II. I built touch-screen
      Mathematica lessons so they could drag a surface around instead of squinting at one, and won the college's award
      for top TA evaluations twice. When we graduated, the department asked me to give the student reflection speech for
      our class.
    </p>
    <a class="video" href={speech.url}>
      <span class="video__thumb">
        <Image src={speechThumb} widths={[220, 440]} sizes="220px" alt="" />
        <svg viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="22" fill="var(--ink)" fill-opacity="0.85"></circle><path d="M17 13 L32 22 L17 31 Z" fill="var(--paper)"></path></svg>
      </span>
      <span class="video__text">
        <strong>Watch the speech</strong>
        <span class="meta">University of Montana math graduation, May 2016. 2 min 49 s, on YouTube.</span>
      </span>
    </a>
    <p>
      I still think like a teacher. If I can't explain a system to someone new in ten minutes, I don't understand it well
      enough yet. That goes double for my own code.
    </p>
  </div>

  <aside class="about__side" aria-label="Where I've been">
    <Image
      class="portrait"
      src={portrait}
      widths={[360, 720]}
      sizes="(max-width: 900px) min(100vw - 40px, 420px), 30vw"
      alt="Gerald laughing on a pier, a cargo ship behind him"
    />
    <ol class="timeline">
      {
        timeline.map((row) => (
          <li>
            <span>{row.name}</span>
            <span class="meta">{row.when}</span>
          </li>
        ))
      }
    </ol>
  </aside>
</section>

<style>
  .about {
    align-items: start;
    row-gap: 48px;
  }

  .about__text {
    grid-column: span 7;
    font-size: 19px;
    line-height: 1.68;
  }

  .about__text .section-title {
    margin-bottom: 12px;
    color: var(--ink);
  }

  .about__lead {
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.3;
    color: var(--ink);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .video {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 20px;
    align-items: center;
    padding: 14px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
  }

  .video:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .video__thumb {
    position: relative;
    display: block;
  }

  .video__thumb :global(img) {
    width: 220px;
    height: 124px;
    object-fit: cover;
    border-radius: 4px;
  }

  .video__thumb svg {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44px;
    translate: -50% -50%;
  }

  .video__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    line-height: 1.4;
  }

  .about__side {
    grid-column: 9 / span 4;
    font-size: 15px;
  }

  .about__side :global(.portrait) {
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: center 22%;
    border-radius: 6px;
    margin-bottom: 32px;
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .timeline li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 0;
    border-top: 1px solid var(--rule);
  }

  .timeline .meta {
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .about__text,
    .about__side {
      grid-column: 1 / -1;
    }

    .about__side :global(.portrait) {
      max-width: 420px;
      height: auto;
      aspect-ratio: 4 / 5;
    }
  }

  @media (max-width: 520px) {
    .video {
      grid-template-columns: 1fr;
    }

    .video__thumb :global(img) {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
