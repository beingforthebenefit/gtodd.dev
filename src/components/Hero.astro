---
import { basics } from '../data/resume';

const linkedin = basics.profiles.find((p) => p.network === 'LinkedIn')!;
const github = basics.profiles.find((p) => p.network === 'GitHub')!;
---

<header class="hero" data-hero>
  <canvas class="hero__field" aria-hidden="true"></canvas>
  <nav class="hero__nav" aria-label="Primary">
    <a class="hero__home" href="/">Gerald Todd</a>
    <ul>
      <li><a href="#work">Work</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#research">Research</a></li>
      <li><a href="#about">About</a></li>
      <li><a class="hero__resume" href="/resume/">Résumé</a></li>
    </ul>
  </nav>
  <div class="hero__copy">
    <h1>Gerald Todd</h1>
    <p class="hero__definition math">
      <strong>Definition.</strong>{' '}
      <em>A software engineer is someone who explains things to computers, and then to whoever maintains the code next.</em>
    </p>
    <p class="hero__lede">
      I taught calculus for four years before I wrote code for a living. Now I'm a Software Engineer III at Einstein
      Industries, building AI tooling for legal work, where a confident wrong answer is worse than none.
    </p>
    <div class="hero__actions">
      <a class="button button--ink" href={`mailto:${basics.email}`}>Email me</a>
      <a class="text-link" href={github.url}>GitHub</a>
      <a class="text-link" href={linkedin.url}>LinkedIn</a>
    </div>
  </div>
  <p class="hero__caption">
    A slope field that bends around your cursor. The red curves are solutions, integrated as you watch.
  </p>
</header>

<script>
  import { mountSlopeField } from '../scripts/slope-field';

  const host = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = host?.querySelector('canvas');
  if (host && canvas) mountSlopeField(canvas, host);
</script>

<style>
  .hero {
    position: relative;
    min-height: min(900px, 100svh);
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 0 var(--gutter) 40px;
    overflow: hidden;
    touch-action: pan-y;
  }

  .hero__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__nav,
  .hero__copy,
  .hero__caption {
    position: relative;
  }

  .hero__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: max(20px, env(safe-area-inset-top));
    font-size: 17px;
  }

  .hero__nav a {
    color: var(--ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .hero__nav a:hover {
    text-decoration: underline;
  }

  .hero__home {
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .hero__nav ul {
    display: flex;
    gap: clamp(14px, 2.4vw, 34px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__nav .hero__resume {
    font-weight: 600;
    color: var(--accent);
  }

  .hero__copy {
    align-self: center;
    max-width: 640px;
    padding-block: clamp(40px, 8vh, 96px);
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 30px);
  }

  h1 {
    font-size: clamp(64px, 11vw, 116px);
    line-height: 0.9;
    font-weight: 750;
    letter-spacing: -0.045em;
  }

  .hero__definition {
    font-size: clamp(22px, 3vw, 31px);
    line-height: 1.32;
  }

  .hero__definition strong {
    font-weight: 600;
  }

  .hero__lede {
    font-size: clamp(17px, 1.8vw, 20px);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 560px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    font-size: 17px;
  }

  .hero__caption {
    justify-self: end;
    max-width: 270px;
    padding: 8px 10px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* Phones: the nav's section links give way to the essentials, and the
     text stacks above the livelier half of the field. */
  @media (max-width: 720px) {
    .hero__nav li:not(:last-child) {
      display: none;
    }

    .hero__copy {
      align-self: start;
      padding-top: 32px;
    }

    .hero {
      min-height: max(760px, 100svh);
    }

    .hero__caption {
      justify-self: start;
    }
  }
</style>
