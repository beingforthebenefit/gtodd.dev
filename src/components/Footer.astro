---
import { basics } from '../data/resume';

const linkedin = basics.profiles.find((p) => p.network === 'LinkedIn')!;
---

<footer class="section footer">
  <h2>Not looking. Always happy to talk.</h2>
  <div class="footer__actions">
    <a class="button button--accent" href={`mailto:${basics.email}`}>{basics.email}</a>
    <a class="text-link" href={linkedin.url}>LinkedIn</a>
    <a class="text-link" href="/resume/">Résumé</a>
  </div>
  <p class="meta">{basics.workSetting}. Built by hand, no template.</p>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    gap: 36px;
    border-top-color: var(--ink);
    padding-bottom: max(56px, env(safe-area-inset-bottom));
  }

  h2 {
    font-size: clamp(40px, 6.5vw, 76px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .footer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    font-size: 17px;
  }
</style>
