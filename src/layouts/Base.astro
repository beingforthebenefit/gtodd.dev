---
import '../styles/global.css';
import { basics } from '../data/resume';
// Preloading the body font means text is laid out once, in the right face,
// instead of shifting when it arrives (Lighthouse caught this on /resume/).
import sansFont from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  schema: object;
  noindex?: boolean;
}

const { title, description, schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og/card.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="author" content={basics.name} />
    <meta name="theme-color" content="#f5f1e6" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/json" href="/resume.json" title="Résumé (JSON Resume)" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for language models" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="gtodd.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gerald Todd, software engineer, over a slope field on graph paper" />
    <meta property="profile:first_name" content="Gerald" />
    <meta property="profile:last_name" content="Todd" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <!-- Cloudflare Web Analytics is injected at the edge (the site is proxied), not here. -->
  </body>
</html>
